# Gemini API Key от Google AI Studio
# Получить здесь: https://aistudio.google.com/
GEMINI_API_KEY=

# Google Drive API Key (Public Folder Access)
# Нужно создать в Google Cloud Console и включить "Google Drive API"
GOOGLE_DRIVE_API_KEY=

# Прокси для Gemini и Drive API (если сервер в заблокированном регионе)
# Пример: socks5h://127.0.0.1:10808
GEMINI_PROXY=

# Порт приложения (по умолчанию 3000)
PORT=3000
