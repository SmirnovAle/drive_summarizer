# Backend-only Gemini API key. Never expose through Vite/client code.
GEMINI_API_KEY=

# Backend-only Google Drive API key for public-folder access.
GOOGLE_DRIVE_API_KEY=

# HTTP Basic Authentication protecting all /api/* endpoints.
# Production startup fails closed when either value is missing.
APP_AUTH_USERNAME=
APP_AUTH_PASSWORD=

# Per-IP /api/summarize rate limit.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# Request/file abuse limits.
MAX_JSON_BODY_MB=20
MAX_FILES=30
MAX_FILE_ENCODED_MB=20
MAX_TOTAL_ENCODED_MB=40

# Optional SOCKS5 proxy used by backend Google requests.
# Example: socks5h://127.0.0.1:10808
GEMINI_PROXY=

# Application port.
PORT=3000
