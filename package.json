    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.0",
    "express": "^5.2.1",
    "node-fetch": "^3.3.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "socks-proxy-agent": "^8.0.3",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
